{
  "id": "./",
  "name": "LifeOS — Dashboard personnel",
  "short_name": "LifeOS",
  "description": "Votre espace personnel pour organiser votre vie et vos finances, directement sur votre appareil.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#f7f7f5",
  "theme_color": "#202322",
  "categories": ["productivity", "finance", "lifestyle"],
  "icons": [
    { "src": "./assets/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./assets/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Dashboard", "short_name": "Dashboard", "url": "./#/", "icons": [{ "src": "./assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Finances", "short_name": "Finances", "url": "./#/finances", "icons": [{ "src": "./assets/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tâches et notes", "short_name": "Personnel", "url": "./#/personal", "icons": [{ "src": "./assets/icon-192.png", "sizes": "192x192" }] }
  ]
}
